@model List<Usuario>
@{
    ViewData["Title"] = "Usuarios";
}

<div class="dashboard-header">
    <div class="container">
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-users me-2"></i>Usuarios registrados</h2>
        <p class="mb-0">Gestiona los usuarios de la plataforma</p>
    </div>
</div>

<div class="container">
    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3"><i class="fa-solid fa-arrow-left me-1"></i>Volver</a>

    <div class="table-responsive shadow-sm rounded-3 bg-white">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Tipo sangre</th>
                    <th>Registro</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.Nombre</td>
                        <td>@u.Email</td>
                        <td><span class="badge bg-secondary">@u.Rol</span></td>
                        <td>@(u.Donante != null ? u.Donante.TipoSangre.ToDisplay() : "-")</td>
                        <td>@u.FechaRegistro.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (u.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-dark">Inactivo</span>
                            }
                        </td>
                        <td>
                            <form asp-controller="Admin" asp-action="CambiarEstadoUsuario" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@u.Id" />
                                <button type="submit" class="btn btn-sm @(u.Activo ? "btn-outline-dark" : "btn-outline-success")">
                                    @(u.Activo ? "Desactivar" : "Activar")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
