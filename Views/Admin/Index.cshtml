@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Panel de administración";
}

<div class="dashboard-header">
    <div class="container">
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-gauge me-2"></i>Panel de administración</h2>
        <p class="mb-0">Vista general de la plataforma Dona Ahora</p>
    </div>
</div>

<div class="container">
    <div class="row g-4 mb-5">
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-number">@Model.TotalUsuarios</div>
                <div class="stat-label"><i class="fa-solid fa-users me-1"></i>Usuarios totales</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-number">@Model.TotalDonantes</div>
                <div class="stat-label"><i class="fa-solid fa-heart me-1"></i>Donantes</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-number">@Model.TotalSolicitudes</div>
                <div class="stat-label"><i class="fa-solid fa-list me-1"></i>Solicitudes totales</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="stat-number">@Model.TotalSolicitudesActivas</div>
                <div class="stat-label"><i class="fa-solid fa-triangle-exclamation me-1"></i>Solicitudes activas</div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <a asp-controller="Admin" asp-action="Usuarios" class="btn btn-outline-danger"><i class="fa-solid fa-users me-1"></i>Ver usuarios</a>
        <a asp-controller="Admin" asp-action="Solicitudes" class="btn btn-outline-danger"><i class="fa-solid fa-list me-1"></i>Ver solicitudes</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <h5 class="section-title mb-3">Últimos usuarios registrados</h5>
            <div class="table-responsive shadow-sm rounded-3 bg-white">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Nombre</th><th>Rol</th><th>Fecha</th></tr></thead>
                    <tbody>
                        @foreach (var u in Model.UltimosUsuarios)
                        {
                            <tr>
                                <td>@u.Nombre</td>
                                <td><span class="badge bg-secondary">@u.Rol</span></td>
                                <td>@u.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-lg-6">
            <h5 class="section-title mb-3">Últimas solicitudes</h5>
            <div class="table-responsive shadow-sm rounded-3 bg-white">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Tipo</th><th>Hospital</th><th>Estado</th></tr></thead>
                    <tbody>
                        @foreach (var s in Model.UltimasSolicitudes)
                        {
                            <tr>
                                <td><span class="badge-sangre">@s.TipoSangre.ToDisplay()</span></td>
                                <td>@s.Hospital</td>
                                <td><span class="badge bg-success">@s.Estado</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
