<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dona Ahora</title>
    <link rel="icon" href="data:,">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top shadow-sm navbar-dona">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-droplet me-2"></i>Dona <span class="text-white-50">Ahora</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-house me-1"></i>Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Solicitudes" asp-action="Index"><i class="fa-solid fa-list me-1"></i>Solicitudes</a></li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            if (User.IsInRole("Donante"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Donante" asp-action="Panel"><i class="fa-solid fa-heart-pulse me-1"></i>Mi Panel</a></li>
                            }
                            else if (User.IsInRole("Solicitante"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Solicitante" asp-action="Index"><i class="fa-solid fa-hand-holding-medical me-1"></i>Mis Solicitudes</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Solicitante" asp-action="Crear"><i class="fa-solid fa-plus me-1"></i>Nueva Solicitud</a></li>
                            }
                            else if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index"><i class="fa-solid fa-gauge me-1"></i>Administración</a></li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item d-flex align-items-center me-3 text-white-50">
                                <i class="fa-solid fa-circle-user me-1"></i> @User.Identity.Name
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm">
                                        <i class="fa-solid fa-right-from-bracket me-1"></i>Salir
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="btn btn-outline-light btn-sm me-2" asp-controller="Account" asp-action="Login">Iniciar sesión</a></li>
                            <li class="nav-item"><a class="btn btn-light btn-sm text-danger fw-semibold" asp-controller="Account" asp-action="Register">Regístrate</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-3">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <main class="pb-5">
        @RenderBody()
    </main>

    <footer class="footer-dona text-white-50 pt-5 pb-4 mt-auto">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-4">
                    <h5 class="text-white"><i class="fa-solid fa-droplet me-2 text-danger"></i>Dona Ahora</h5>
                    <p class="small">Una plataforma que conecta donantes y solicitantes de sangre para salvar vidas todos los días.</p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white">Enlaces</h6>
                    <ul class="list-unstyled small">
                        <li><a class="footer-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li><a class="footer-link" asp-controller="Solicitudes" asp-action="Index">Solicitudes activas</a></li>
                        <li><a class="footer-link" asp-controller="Account" asp-action="Register">Quiero donar</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white">Proyecto Universitario</h6>
                    <p class="small mb-0">Desarrollado con ASP.NET Core MVC, EF Core y SQL Server.</p>
                    <p class="small">&copy; @DateTime.Now.Year Dona Ahora — Todos los derechos reservados.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
