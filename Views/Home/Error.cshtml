@{
    ViewData["Title"] = "Error";
}
<div class="container text-center py-5">
    <i class="fa-solid fa-triangle-exclamation text-danger" style="font-size: 4rem;"></i>
    <h2 class="mt-3">Ha ocurrido un error</h2>
    <p class="text-muted">Lo sentimos, algo salió mal al procesar tu solicitud.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-danger mt-3">Volver al inicio</a>
</div>
