@model SolicitanteDashboardViewModel
@{
    ViewData["Title"] = "Mis solicitudes";
}

<div class="dashboard-header">
    <div class="container d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1"><i class="fa-solid fa-hand-holding-medical me-2"></i>Mis solicitudes</h2>
            <p class="mb-0">Gestiona tus solicitudes de sangre</p>
        </div>
        <a asp-controller="Solicitante" asp-action="Crear" class="btn btn-dona-primary mt-3 mt-md-0">
            <i class="fa-solid fa-plus me-2"></i>Nueva solicitud
        </a>
    </div>
</div>

<div class="container">
    @if (Model.MisSolicitudes.Any())
    {
        <div class="row g-4">
            @foreach (var s in Model.MisSolicitudes)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card card-dona h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge-sangre">@s.TipoSangre.ToDisplay()</span>
                                <span class="badge urgencia-@s.Urgencia.ToString().ToLower()">@s.Urgencia</span>
                            </div>
                            <h6 class="fw-bold mb-1"><i class="fa-solid fa-hospital me-1 text-danger"></i>@s.Hospital</h6>
                            <p class="text-muted small mb-1"><i class="fa-solid fa-location-dot me-1"></i>@s.Ciudad</p>
                            <p class="small mb-2"><i class="fa-regular fa-calendar me-1"></i>@s.Fecha.ToString("dd/MM/yyyy")</p>
                            <p class="small mb-2">
                                <i class="fa-solid fa-hand-holding-heart me-1 text-danger"></i>
                                @s.Intereses.Count donante(s) interesado(s)
                            </p>
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge @(s.Estado == EstadoSolicitud.Activa ? "bg-success" : s.Estado == EstadoSolicitud.Completada ? "bg-secondary" : s.Estado == EstadoSolicitud.Cancelada ? "bg-dark" : "bg-warning text-dark")">
                                        @s.Estado
                                    </span>
                                    <a asp-controller="Solicitante" asp-action="Detalle" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">
                                        Ver detalle
                                    </a>
                                </div>
                                @if (s.Estado != EstadoSolicitud.Completada)
                                {
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Solicitante" asp-action="Editar" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary flex-fill">
                                            <i class="fa-solid fa-pen"></i> Editar
                                        </a>
                                        <form asp-controller="Solicitante" asp-action="Eliminar" method="post" class="flex-fill" onsubmit="return confirm('¿Seguro que quieres eliminar esta solicitud? Esta acción no se puede deshacer.');">
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                                <i class="fa-solid fa-trash"></i> Eliminar
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-light border text-center py-5">
            <i class="fa-solid fa-droplet fs-2 text-danger mb-2 d-block"></i>
            Aún no has creado ninguna solicitud.
            <div class="mt-3">
                <a asp-controller="Solicitante" asp-action="Crear" class="btn btn-danger">Crear mi primera solicitud</a>
            </div>
        </div>
    }
</div>
